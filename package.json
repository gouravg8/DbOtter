{
  "name": "dbotter",
  "private": true,
  "version": "0.0.2",
  "author": "Gourav Soni (https://x.com/gouravsoni88)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bridge": "cargo run --manifest-path src-tauri/Cargo.toml --example bridge --",
    "dev:browser": "VITE_DBOTTER_BRIDGE=http://127.0.0.1:1430 vite",
    "test": "pnpm test:unit && pnpm test:rust",
    "test:unit": "node --test src/lib/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^1.59.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
