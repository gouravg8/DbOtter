{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DbOtter",
  "version": "0.0.1",
  "identifier": "info.smoothops.dbotter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DbOtter",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Gourav Soni",
    "shortDescription": "Fast, keyboard-first database client",
    "longDescription": "DbOtter is a fast, keyboard-first client for PostgreSQL, MySQL / MariaDB and SQLite: browse tables, run SQL with vim mode, switch themes, all in a small native app."
  }
}
